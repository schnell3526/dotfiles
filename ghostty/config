# Theme Settings
# OS のライト/ダークに合わせて切り替える
theme = light:Catppuccin Latte,dark:Catppuccin Macchiato

# Font Settings
font-family = 'HackGen Console NF'
font-feature = "-calt"
font-feature = "-dlig"
font-feature = "-liga"
font-size = 16
font-thicken = true
adjust-cell-height = 2

# Window Settings
macos-titlebar-style = "transparent"
macos-window-shadow = false
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0
window-theme = "ghostty"
background-blur-radius = 20
background-opacity = 0.85

# Background Image（パスは Application Support 側の config があるディレクトリからの相対。setup.sh でリンクする）
background-image = images/stars.png
background-image-opacity = 0.7
background-image-fit = cover

# Shader
custom-shader = shaders/cursor_trail.glsl

# Split
unfocused-split-opacity = 0.6

# Quick Terminal（どのアプリからでも cmd+` で開閉。アクセシビリティ権限が必要）
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15

# App Icon
macos-icon = holographic

# Cursor Settings
cursor-style = "block"
cursor-style-blink = false

# Other Settings
mouse-hide-while-typing = true

# TERM
term = "xterm-256color"
