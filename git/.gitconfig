[include]
    path = ~/dotfiles/git/local.gitconfig
	path = ~/dotfiles/git/.gitconfig.secret
[core]
    quotepath = false
[init]
    defaultBranch = main

# 認証情報は平文保存（store）せず、macOS キーチェーンに保存
[credential]
	helper = osxkeychain
# GitHub は gh のトークンを使う（gh auth login 済みが前提）
# gh は mise 管理。GUI アプリなど mise 未有効の環境からも動くよう shim を直接指す
[credential "https://github.com"]
	helper =
	helper = !\"$HOME/.local/share/mise/shims/gh\" auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !\"$HOME/.local/share/mise/shims/gh\" auth git-credential
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
